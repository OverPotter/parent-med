{
  "expo": {
    "name": "PillPath",
    "slug": "pillpath-ios",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "pillpath",
    "plugins": ["./plugins/withLiveActivities", "expo-notifications"],
    "splash": {
      "backgroundColor": "#EBE4FF"
    },
    "ios": {
      "buildNumber": "2",
      "deploymentTarget": "16.1",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSLocalNetworkUsageDescription": "PillPath uses your local network during development to connect to the Metro bundler."
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.overpotter.pillpath"
    }
  }
}
