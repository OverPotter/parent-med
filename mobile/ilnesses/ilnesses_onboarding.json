{
  "screen_name": "StartObservationOnboarding",
  "app": "PillPath",
  "language": "ru",
  "platform": "iOS",
  "purpose": "Экран запуска нового наблюдения болезни для выбранного ребёнка.",
  "context": {
    "module": "Журнал",
    "flow": "Пользователь выбирает ребёнка и начинает новое наблюдение болезни. После запуска наблюдения ребёнок появляется на главном экране Журнала в виде активной карточки.",
    "entry_points": [
      "Экран профиля ребёнка → кнопка Начать наблюдение",
      "Экран Дети → карточка ребёнка → Начать наблюдение",
      "Экран Журнал → если у ребёнка нет активного наблюдения",
      "Экран Обзор ребёнка → Начать наблюдение"
    ],
    "after_success": {
      "action": "create_active_observation",
      "navigate_to": "JournalActiveObservationList",
      "result": "На экране Журнал появляется карточка ребёнка с активным наблюдением."
    }
  },
  "design_goal": {
    "main_goal": "Сделать экран начала болезни спокойным, быстрым и не перегруженным.",
    "ux_principle": "Пользователь не обязан сразу заполнять много данных. Достаточно выбрать дату начала и, при желании, коротко написать, что случилось.",
    "important": [
      "Экран должен соответствовать новому тёплому стилю PillPath.",
      "Не использовать старый фиолетовый фон.",
      "Не превращать экран в медицинскую анкету.",
      "Главный CTA — Начать наблюдение.",
      "Поля температуры, лекарств и напоминаний не добавлять на этот экран — они будут внутри активного наблюдения.",
      "Экран должен выглядеть спокойно, чтобы не усиливать тревогу родителя."
    ]
  },
  "target_device": {
    "design_width": 393,
    "design_height": 852,
