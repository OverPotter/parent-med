# Production API origin (without /api/v1).
VITE_API_URL=https://parent-med-production.up.railway.app

# Public frontend/marketing origin used for associated domains.
VITE_MARKETING_SITE_URL=https://parent-med-production-frontend.up.railway.app/

# Optional analytics script.
VITE_HITKEEP_SCRIPT_URL=https://parent-med-analytic.up.railway.app/hk.js

# RevenueCat production configuration.
VITE_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key_here
VITE_REVENUECAT_SYNC_BACKEND=true
VITE_REVENUECAT_ENTITLEMENT_CODE=plus
