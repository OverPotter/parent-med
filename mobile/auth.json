{
  "screen_name": "PillPath Final Auth Screen",
  "platform": "iOS",
  "target_device": "iPhone Pro Max",
  "canvas": {
    "width": 1290,
    "height": 2796,
    "orientation": "portrait",
    "safe_area": {
      "top": 135,
      "bottom": 80,
      "left": 72,
      "right": 72
    }
  },
  "product_context": {
    "app_name": "PillPath",
    "product_type": "family health and child care tracker",
    "main_user": "parents, grandparents, nannies and family caregivers",
    "main_meaning": "The user enters a shared family health base for child care, medicines, symptoms, reminders, sleep, feeding and family access.",
    "visual_goal": "Warm, caring, premium iOS auth screen. It should feel like a safe family care app, not a medical hospital dashboard."
  },
  "global_style": {
    "mood": [
      "warm",
      "calm",
      "family",
      "safe",
      "premium",
      "soft",
      "modern iOS",
      "home care"
    ],
    "avoid": [
      "hospital UI",
      "cold white medical interface",
      "enterprise SaaS login",
      "hard modal card",
      "social network style",
      "childish cartoon style",
      "aggressive blue or green medical palette",
      "too much marketing content"
    ]
  },
  "background": {
    "type": "image_background",
    "description": "Use the cozy home healthcare background as the base image. It should show a warm living room with sunlight, sofa, plant, medicine organizer, water glass, family care calendar and home health objects.",
    "placement": {
      "mode": "cover",
      "x": 0,
      "y": 0,
      "width": 1290,
      "height": 2796
    },
    "image_adjustments": {
      "brightness": "+2%",
      "contrast": "-5%",
      "saturation": "-4%",
      "warmth": "+5%"
    },
    "top_scene_rules": {
      "keep_visible": true,
      "important_visible_objects": [
        "window with sunlight",
        "plant",
        "sofa",
        "medicine organizer",
        "calendar",
        "home health objects"
      ],
      "do_not_cover_too_much": true,
      "description": "The top part should remain emotional and recognizable. Do not crop it into a meaningless header."
    },
    "readability_overlay": {
      "enabled": true,
      "type": "very_soft_vertical_gradient",
      "description": "Soft warm overlay to improve readability in the lower half, without making the screen look white.",
      "colors": [
        {
          "position": 0,
          "color": "rgba(255, 246, 238, 0.00)"
        },
        {
          "position": 0.42,
          "color": "rgba(255, 246, 238, 0.10)"
        },
        {
          "position": 0.62",
          "color": "rgba(255, 246, 238, 0.28)"
        },
        {
          "position": 1,
          "color": "rgba(255, 249, 242, 0.74)"
        }
      ]
    }
  },
  "lower_form_background": {
    "type": "soft_background_blob_not_card",
    "critical_instruction": "This must not look like a separate white modal, bottom sheet or card. It must look like a warm cream continuation of the background.",
    "position": {
      "x": 0,
      "y": 995
    },
    "size": {
      "width": 1290,
      "height": 1801
    },
    "shape": {
      "type": "organic_bottom_background",
      "top_edge": "very soft rounded organic wave",
      "top_left_radius": 190,
      "top_right_radius": 190,
      "top_center_curve": "slightly lower than the sides, smooth and natural",
      "bottom": "fills to bottom of screen",
      "description": "The top edge should feel like a soft milk cloud/blend rising over the photo. It should be smooth, organic and slightly asymmetrical."
    },
    "fill": {
      "type": "warm_cream_gradient",
      "colors": [
        "rgba(255, 249, 242, 0.88)",
        "rgba(255, 245, 236, 0.94)",
        "rgba(255, 250, 245, 0.98)"
      ],
      "direction": "top_to_bottom"
    },
    "border": {
      "enabled": false
    },
    "shadow": {
      "enabled": false
    },
    "blend": {
      "feather_top_edge": true,
      "feather_amount": 42,
      "description": "The transition between the home photo and the cream lower area must be soft. No hard edge."
    }
  },
  "color_system": {
    "primary_coral": "#F87566",
    "primary_coral_dark": "#EF6658",
    "primary_coral_light": "#FF9A8E",
    "warm_milk": "#FFF9F2",
    "warm_cream": "#FFF5EC",
    "warm_surface": "rgba(255, 255, 255, 0.58)",
    "soft_peach": "#F5DCD2",
    "soft_border": "#EFDCD3",
    "main_text": "#26384D",
    "secondary_text": "#6E7F91",
    "muted_text": "#8C7D75",
    "placeholder_text": "#AFA6A0",
    "icon_gray": "#77706C",
    "link": "#F87566",
    "error": "#D65B50"
  },
  "typography": {
    "font_family": "SF Pro Display",
    "fallback": "Plus Jakarta Sans",
    "headline": {
      "font_size": 43,
      "line_height": 56,
      "font_weight": 750,
      "letter_spacing": -0.5,
      "color": "#26384D"
    },
    "input": {
      "font_size": 31,
      "line_height": 40,
      "font_weight": 500,
      "color": "#26384D"
    },
    "button": {
      "font_size": 38,
      "font_weight": 750,
      "color": "#FFFFFF"
    },
    "body": {
      "font_size": 28,
      "line_height": 38,
      "font_weight": 500
    },
    "small": {
      "font_size": 24,
      "line_height": 34,
      "font_weight": 500
    }
  },
  "layout": {
    "content_width": 1080,
    "content_x": 105,
    "alignment": "center",
    "login_positions": {
      "segmented_control_y": 1135,
      "headline_y": 1325,
      "form_fields_y": 1510,
      "auth_options_y": 1748,
      "primary_button_y": 1850,
      "bottom_switch_text_y": 2028,
      "legal_links_y": 2258
    },
    "register_positions": {
      "segmented_control_y": 1115,
      "headline_y": 1275,
      "form_fields_y": 1438,
      "primary_button_y": 1855,
      "bottom_switch_text_y": 2028,
      "legal_consent_y": 2145,
      "legal_links_y": 2370
    },
    "animation_rule": "When switching between login and registration, the layout must reflow smoothly. Do not create a new screen. Do not move the background or the lower cream area."
  },
  "components": [
    {
      "id": "status_bar",
      "type": "native_ios_status_bar",
      "position": {
        "x": 0,
        "y": 0
      },
      "style": {
        "time": "19:11",
        "dynamic_island": true,
        "color": "#000000",
        "background": "transparent"
      }
    },
    {
      "id": "auth_switch",
      "type": "segmented_control",
      "description": "Switch between Login and Registration. It must be soft and iOS-like, not heavy.",
      "position_login": {
        "x": 105,
        "y": 1135
      },
      "position_register": {
        "x": 105,
        "y": 1115
      },
      "size": {
        "width": 1080,
        "height": 92
      },
      "container": {
        "background": "rgba(255, 255, 255, 0.42)",
        "border": {
          "enabled": true,
          "color": "rgba(239, 220, 211, 0.90)",
          "width": 1.3
        },
        "corner_radius": 46,
        "shadow": {
          "enabled": false
        }
      },
      "active_pill": {
        "background": "rgba(255, 255, 255, 0.88)",
        "corner_radius": 40,
        "inset": 8,
        "shadow": {
          "enabled": true,
          "color": "rgba(120, 70, 45, 0.07)",
          "blur": 16,
          "y": 5
        }
      },
      "items": [
        {
          "id": "login_tab",
          "label": "Вход",
          "active_in_state": "login",
          "width": 532
        },
        {
          "id": "register_tab",
          "label": "Регистрация",
          "active_in_state": "register",
          "width": 532
        }
      ],
      "text_style": {
        "active": {
          "color": "#26384D",
          "font_size": 31,
          "font_weight": 750
        },
        "inactive": {
          "color": "#8C7D75",
          "font_size": 31,
          "font_weight": 600
        }
      },
      "logic": {
        "default_state": "login",
        "on_tap_login": {
          "set_state": "login",
          "active_pill_position": "left",
          "headline": "Войдите, чтобы вернуться\nк семейной базе.",
          "visible_fields": [
            "email",
            "password"
          ],
          "hidden_fields": [
            "confirm_password"
          ],
          "show_remember_me": true,
          "show_forgot_password": true,
          "button_text": "Войти",
          "show_legal_consent": false
        },
        "on_tap_register": {
          "set_state": "register",
          "active_pill_position": "right",
          "headline": "Создайте семейную базу\nздоровья и ухода.",
          "visible_fields": [
            "email",
            "password",
            "confirm_password"
          ],
          "show_remember_me": false,
          "show_forgot_password": false,
          "button_text": "Создать аккаунт",
          "show_legal_consent": true
        },
        "animation": {
          "type": "spring_slide",
          "duration_ms": 260,
          "active_pill_moves_between_tabs": true,
          "form_reflows_vertically": true,
          "confirm_password_fades_and_slides": true
        }
      },
      "important": "Do not make the active tab coral. Coral is reserved for the primary CTA and links."
    },
    {
      "id": "headline",
      "type": "text",
      "state_dependent": true,
      "position_login": {
        "x": 145,
        "y": 1325
      },
      "position_register": {
        "x": 145,
        "y": 1275
      },
      "size": {
        "width": 1000,
        "height": 135
      },
      "text_login": "Войдите, чтобы вернуться\nк семейной базе.",
      "text_register": "Создайте семейную базу\nздоровья и ухода.",
      "style": {
        "font_size": 43,
        "line_height": 56,
        "font_weight": 750,
        "color": "#26384D",
        "alignment": "center"
      }
    },
    {
      "id": "form_fields",
      "type": "input_group",
      "position_login": {
        "x": 105,
        "y": 1510
      },
      "position_register": {
        "x": 105,
        "y": 1438
      },
      "size_login": {
        "width": 1080,
        "height": 212
      },
      "size_register": {
        "width": 1080,
        "height": 328
      },
      "group_style": {
        "background": "rgba(255, 255, 255, 0.48)",
        "border": {
          "color": "#EFDCD3",
          "width": 1.5
        },
        "corner_radius": 30,
        "clip_children": true
      },
      "divider_style": {
        "height": 1.2,
        "color": "#EFDCD3",
        "x_inset": 0
      },
      "field_style": {
        "height": 106,
        "background": "transparent",
        "icon_size": 36,
        "icon_color": "#77706C",
        "placeholder_color": "#AFA6A0",
        "text_color": "#26384D",
        "font_size": 31,
        "font_weight": 500,
        "padding_left": 92,
        "padding_right": 82
      },
      "fields": [
        {
          "id": "email",
          "type": "email",
          "placeholder": "you@example.com",
          "icon_left": "mail",
          "keyboard": "email",
          "autocapitalize": false,
          "required": true,
          "visible_in_states": [
            "login",
            "register"
          ],
          "validation": {
            "rule": "valid_email",
            "error_text": "Введите корректный email"
          }
        },
        {
          "id": "password",
          "type": "password",
          "placeholder": "Минимум 8 символов",
          "icon_left": "lock",
          "icon_right": "eye",
          "required": true,
          "visible_in_states": [
            "login",
            "register"
          ],
          "validation": {
            "rule": "min_length_8",
            "error_text": "Пароль должен быть не короче 8 символов"
          },
          "logic": {
            "eye_tap": {
              "toggle_secure_text_entry": true,
              "icon_closed": "eye",
              "icon_open": "eye_off"
            }
          }
        },
        {
          "id": "confirm_password",
          "type": "password",
          "placeholder": "Повторите пароль",
          "icon_left": "lock",
          "icon_right": "eye",
          "required_in_state": "register",
          "visible_in_states": [
            "register"
          ],
          "validation": {
            "rule": "matches_password",
            "error_text": "Пароли не совпадают"
          },
          "logic": {
            "eye_tap": {
              "toggle_secure_text_entry": true,
              "icon_closed": "eye",
              "icon_open": "eye_off"
            }
          }
        }
      ],
      "focus_state": {
        "border_color": "#F87566",
        "shadow": {
          "color": "rgba(248,117,102,0.14)",
          "blur": 18,
          "y": 5
        }
      }
    },
    {
      "id": "auth_options_row",
      "type": "horizontal_row",
      "visible_in_state": "login",
      "position": {
        "x": 105,
        "y": 1748
      },
      "size": {
        "width": 1080,
        "height": 54
      },
      "left": {
        "type": "checkbox_with_label",
        "id": "remember_me",
        "checked": true,
        "checkbox": {
          "size": 44,
          "corner_radius": 12,
          "checked_background": "#F87566",
          "unchecked_background": "rgba(255,255,255,0.55)",
          "unchecked_border": "#EFDCD3",
          "check_icon_color": "#FFFFFF"
        },
        "label": {
          "text": "Запомнить меня",
          "font_size": 27,
          "font_weight": 600,
          "color": "#26384D"
        },
        "logic": {
          "on_tap": "toggle_checked"
        }
      },
      "right": {
        "type": "text_link",
        "id": "forgot_password",
        "text": "Забыли пароль?",
        "font_size": 27,
        "font_weight": 650,
        "color": "#F87566",
        "logic": {
          "on_tap": "open_forgot_password_flow"
        }
      }
    },
    {
      "id": "primary_button",
      "type": "button",
      "state_dependent": true,
      "position_login": {
        "x": 105,
        "y": 1850
      },
      "position_register": {
        "x": 105,
        "y": 1855
      },
      "size": {
        "width": 1080,
        "height": 112
      },
      "text_login": "Войти",
      "text_register": "Создать аккаунт",
      "style": {
        "background": {
          "type": "linear_gradient",
          "colors": [
            "#FF8274",
            "#F87566",
            "#EF6658"
          ],
          "direction": "left_to_right"
        },
        "corner_radius": 30,
        "shadow": {
          "enabled": true,
          "color": "rgba(248,117,102,0.28)",
          "blur": 24,
          "y": 10
        },
        "text": {
          "font_size": 38,
          "font_weight": 750,
          "color": "#FFFFFF"
        }
      },
      "disabled_style": {
        "background": "#EBC8BF",
        "text_color": "rgba(255,255,255,0.82)",
        "shadow": {
          "enabled": false
        }
      },
      "logic": {
        "enabled_when_login": "email_valid && password_length >= 8",
        "enabled_when_register": "email_valid && password_length >= 8 && confirm_password_matches && legal_consent_checked",
        "on_tap_login": "submit_login",
        "on_tap_register": "submit_registration",
        "loading_state": {
          "show_spinner": true,
          "text_login": "Входим…",
          "text_register": "Создаём…",
          "disable_inputs": true
        }
      },
      "important": "The button must look active and confident. Do not make it pale pink like a disabled button."
    },
    {
      "id": "bottom_switch_text",
      "type": "inline_text_link",
      "state_dependent": true,
      "position": {
        "x": 105,
        "y": 2028
      },
      "size": {
        "width": 1080,
        "height": 54
      },
      "login_text": {
        "prefix": "Нет аккаунта?",
        "link": "Зарегистрироваться"
      },
      "register_text": {
        "prefix": "Уже есть аккаунт?",
        "link": "Войти"
      },
      "style": {
        "alignment": "center",
        "prefix": {
          "font_size": 28,
          "font_weight": 500,
          "color": "#6E625C"
        },
        "link": {
          "font_size": 28,
          "font_weight": 700,
          "color": "#F87566"
        }
      },
      "logic": {
        "on_tap_login_link": "switch_to_login",
        "on_tap_register_link": "switch_to_register"
      }
    },
    {
      "id": "legal_consent_register",
      "type": "checkbox_text",
      "visible_in_state": "register",
      "position": {
        "x": 105,
        "y": 2145
      },
      "size": {
        "width": 1080,
        "height": 92
      },
      "checkbox": {
        "id": "legal_consent",
        "checked": true,
        "size": 42,
        "corner_radius": 11,
        "checked_background": "#F87566",
        "unchecked_background": "rgba(255,255,255,0.55)",
        "unchecked_border": "#EFDCD3",
        "check_icon_color": "#FFFFFF"
      },
      "text": {
        "content": "Я соглашаюсь с Условиями использования и Политикой конфиденциальности",
        "font_size": 23,
        "line_height": 34,
        "font_weight": 500,
        "color": "#6E625C",
        "link_color": "#F87566",
        "link_underline": true
      },
      "logic": {
        "checkbox_tap": "toggle_checked",
        "terms_tap": "open_terms",
        "privacy_tap": "open_privacy_policy"
      }
    },
    {
      "id": "legal_links",
      "type": "legal_text",
      "position_login": {
        "x": 105,
        "y": 2258
      },
      "position_register": {
        "x": 105,
        "y": 2370
      },
      "size": {
        "width": 1080,
        "height": 44
      },
      "text": "Условия использования  ·  Политика конфиденциальности",
      "style": {
        "font_size": 24,
        "font_weight": 500,
        "color": "#8C7D75",
        "alignment": "center"
      },
      "logic": {
        "terms_tap": "open_terms",
        "privacy_tap": "open_privacy_policy"
      }
    }
  ],
  "login_state": {
    "description": "Default state for returning users.",
    "visible_components": [
      "status_bar",
      "auth_switch",
      "headline",
      "form_fields.email",
      "form_fields.password",
      "auth_options_row",
      "primary_button",
      "bottom_switch_text",
      "legal_links"
    ],
    "hidden_components": [
      "form_fields.confirm_password",
      "legal_consent_register"
    ],
    "headline_text": "Войдите, чтобы вернуться\nк семейной базе.",
    "button_text": "Войти"
  },
  "register_state": {
    "description": "Registration state for creating a new family base.",
    "visible_components": [
      "status_bar",
      "auth_switch",
      "headline",
      "form_fields.email",
      "form_fields.password",
      "form_fields.confirm_password",
      "primary_button",
      "bottom_switch_text",
      "legal_consent_register",
      "legal_links"
    ],
    "hidden_components": [
      "auth_options_row"
    ],
    "headline_text": "Создайте семейную базу\nздоровья и ухода.",
    "button_text": "Создать аккаунт"
  },
  "interaction_details": {
    "switch_login_register": {
      "animation": "The active pill slides between tabs. The headline text crossfades. The confirm password field fades and slides in. The lower elements reflow vertically.",
      "duration_ms": 260,
      "easing": "easeOut",
      "must_not": [
        "Do not reload the whole screen.",
        "Do not change the background.",
        "Do not create a second layout.",
        "Do not move the lower cream background blob.",
        "Do not create a new modal/card for registration."
      ]
    },
    "keyboard_behavior": {
      "description": "When the keyboard opens, move the form content slightly upward if needed. Keep the background fixed.",
      "avoid_overlap": true
    },
    "input_errors": {
      "style": {
        "font_size": 21,
        "color": "#D65B50",
        "icon": "small warning circle"
      },
      "placement": "Below the related field, inside the same vertical flow. Do not overlap other elements."
    }
  },
  "critical_visual_rules": [
    "The lower cream area is not a card, not a modal and not a bottom sheet.",
    "Do not add a hard white rounded rectangle behind the form.",
    "The cream area must blend with the photo and look like a natural soft background continuation.",
    "No visible hard border around the lower blob.",
    "No heavy shadow around the lower blob.",
    "The top cozy home scene must remain visible and emotionally important.",
    "The auth UI should be compact enough to leave breathing space.",
    "The CTA button must be strong coral and clearly active.",
    "Segmented control active tab should be white, not coral.",
    "Use coral only for CTA, links and checked checkboxes.",
    "Use navy/slate for main text, not pure black.",
    "Use warm milk surfaces, not cold white.",
    "Keep login and registration as two states of the same screen.",
    "Registration has one extra input row, so the layout must reflow vertically.",
    "Do not add extra promotional cards or feature blocks."
  ],
  "final_quality_target": "A premium warm iOS login/registration screen for PillPath over a cozy family health home background. The form sits on a soft warm cream lower background area that blends with the scene, not inside a separate modal card."
}