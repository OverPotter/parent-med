# Mobile can reuse the same public config surface as the legacy frontend.
# app.config.ts reads either VITE_* or EXPO_PUBLIC_* and mirrors values into Expo extra.

# Backend origin with protocol, without path. The app adds /api/v1 itself.
# Example: https://pillpath-production.up.railway.app
# VITE_API_URL=

# Public website origin for iOS associated domains / applinks / webcredentials.
# Example: https://parent-med-production-frontend.up.railway.app
# VITE_APP_SITE_URL=

# Optional external legal/support URLs if you later need to align mobile with website copy.
# VITE_PRIVACY_POLICY_URL=https://example.com/privacy
# VITE_TERMS_OF_USE_URL=https://example.com/terms
# VITE_SUPPORT_URL=https://example.com/support
# VITE_SUPPORT_EMAIL=support@example.com

# Optional marketing site origin. Also contributes to associated domains if configured.
# VITE_MARKETING_SITE_URL=https://example.com

# Public App Store metadata used by the shared config layer.
# VITE_APP_STORE_URL=https://apps.apple.com/app/id6762408566
# VITE_APP_STORE_ID=6762408566

# RevenueCat public iOS config surface.
# VITE_REVENUECAT_IOS_API_KEY=
# VITE_REVENUECAT_SYNC_BACKEND=false
# VITE_REVENUECAT_ENTITLEMENT_CODE=plus
# VITE_REVENUECAT_DEFAULT_PACKAGE_ID=

# Optional override if you need a different release bundle id.
# IOS_BUNDLE_IDENTIFIER=com.overpotter.pillpath
