{
  "screen": {
    "name": "AuthScreen",
    "purpose": "Экран входа и регистрации для приложения PillPath",
    "device_target": "iPhone only",
    "recommended_canvas_size": {
      "width": 1290,
      "height": 2796,
      "aspect_ratio": "19.5:9"
    },
    "layout_type": "vertical_auth_screen",
    "safe_area": {
      "top": 80,
      "bottom": 60,
      "left": 48,
      "right": 48
    },
    "background_logic": {
      "type": "full_screen_image",
      "position": "top",
      "height_percent": 46,
      "description": "Верхняя часть экрана занята эмоциональной фоновой иллюстрацией: семейная сцена дома, столик, аптечка, календарь, таблетница. Изображение не должно мешать форме входа.",
      "image_crop": {
        "mode": "cover",
        "focus_area": "center_top",
        "important_objects_area": {
          "x_min_percent": 5,
          "x_max_percent": 95,
          "y_min_percent": 4,
          "y_max_percent": 45
        }
      },
      "blur": {
        "enabled": true,
        "strength": "light_to_medium",
        "note": "Фон с семьей должен быть чуть мягче, чем UI-форма, чтобы не конкурировать с кнопками и текстом."
      }
    }
  },
  "main_sheet": {
    "type": "bottom_rounded_sheet",
    "position": {
      "x": 0,
      "y_percent": 41,
      "width_percent": 100,
      "height_percent": 59
    },
    "shape": {
      "top_left_radius": 96,
      "top_right_radius": 96,
      "bottom_left_radius": 0,
      "bottom_right_radius": 0
    },
    "wave_top_edge": {
      "enabled": true,
      "style": "soft_wave",
      "amplitude": 28,
      "description": "Верхняя линия бело-персикового блока не идеально ровная, а мягкая волна. Это делает переход от картинки к форме живым и менее жестким."
    },
    "padding": {
      "top": 92,
      "left": 72,
      "right": 72,
      "bottom": 56
    },
    "content_alignment": "center",
    "max_content_width": 1050,
    "note": "Вся форма входа находится внутри нижнего блока. Фоновые предметы сверху не должны заходить на интерактивные элементы."
  },
  "logo_block": {
    "position": {
      "inside": "main_sheet",
      "align": "center",
      "top_offset": 42
    },
    "app_icon": {
      "enabled": true,
      "size": {
        "width": 142,
        "height": 142
      },
      "corner_radius": 36,
      "shadow": {
        "enabled": true,
        "blur": 22,
        "opacity": 0.12,
        "y": 8
      },
      "content": "leaf_plus_pill_icon",
      "note": "Иконка должна быть простой, без текста. Используется как эмоциональный якорь перед названием."
    },
    "app_name": {
      "text": "PillPath",
      "top_margin": 34,
      "font": {
        "family": "Plus Jakarta Sans или SF Pro Display",
        "size": 72,
        "weight": 700,
        "line_height": 82,
        "letter_spacing": -1.2
      },
      "alignment": "center"
    }
  },
  "auth_tabs": {
    "type": "segmented_control",
    "position": {
      "top_margin_after_logo": 54,
      "height": 76,
      "width_percent": 100
    },
    "shape": {
      "corner_radius": 28,
      "border_width": 1
    },
    "items": [
      {
        "id": "login",
        "label": "Вход",
        "state": "active"
      },
      {
        "id": "register",
        "label": "Регистрация",
        "state": "inactive"
      }
    ],
    "active_item": {
      "height": 68,
      "margin": 4,
      "corner_radius": 24,
      "shadow": {
        "enabled": true,
        "blur": 12,
        "opacity": 0.12,
        "y": 4
      }
    },
    "font": {
      "family": "Plus Jakarta Sans или SF Pro Text",
      "size": 30,
      "weight_active": 600,
      "weight_inactive": 500,
      "line_height": 38
    },
    "logic": {
      "login_tab": "Показывает поля email и password, кнопку входа, забыли пароль и Google login.",
      "register_tab": "Показывает поля имя, email, password, confirm password или только email/password в зависимости от выбранной логики регистрации.",
      "animation": "При переключении активный индикатор плавно переезжает между вкладками за 180-240ms."
    }
  },
  "form_login": {
    "visible_when": "auth_tabs.active == login",
    "position": {
      "top_margin_after_tabs": 44
    },
    "fields": [
      {
        "id": "email",
        "type": "email",
        "placeholder": "Электронная почта",
        "icon": "mail",
        "height": 78,
        "corner_radius": 24,
        "border_width": 1,
        "padding_left": 76,
        "padding_right": 28,
        "font": {
          "family": "SF Pro Text или Plus Jakarta Sans",
          "size": 28,
          "weight": 400,
          "line_height": 36
        },
        "icon_size": 32
      },
      {
        "id": "password",
        "type": "password",
        "placeholder": "Пароль",
        "icon_left": "lock",
        "icon_right": "eye",
        "height": 78,
        "corner_radius": 24,
        "border_width": 1,
        "padding_left": 76,
        "padding_right": 76,
        "top_margin": 26,
        "font": {
          "family": "SF Pro Text или Plus Jakarta Sans",
          "size": 28,
          "weight": 400,
          "line_height": 36
        },
        "icon_size": 32,
        "logic": {
          "eye_icon": "Показывает или скрывает пароль."
        }
      }
    ],
    "forgot_password": {
      "text": "Забыли пароль?",
      "position": {
        "align": "right",
        "top_margin": 22
      },
      "font": {
        "family": "SF Pro Text или Plus Jakarta Sans",
        "size": 25,
        "weight": 500,
        "line_height": 32
      },
      "tap_area": {
        "height": 48
      },
      "logic": "Открывает экран восстановления пароля или bottom sheet с вводом email."
    },
    "primary_button": {
      "text": "Войти",
      "position": {
        "top_margin": 40
      },
      "height": 86,
      "width_percent": 100,
      "corner_radius": 26,
      "font": {
        "family": "Plus Jakarta Sans или SF Pro Text",
        "size": 32,
        "weight": 700,
        "line_height": 40
      },
      "shadow": {
        "enabled": true,
        "blur": 18,
        "opacity": 0.16,
        "y": 8
      },
      "logic": {
        "default": "Активна, если email валидный и пароль не пустой.",
        "loading_state": "Показывает loader вместо текста.",
        "disabled_state": "Кнопка приглушается, если поля заполнены неправильно."
      }
    }
  },
  "divider": {
    "visible_when": "social_login_enabled == true",
    "position": {
      "top_margin_after_primary_button": 42
    },
    "height": 32,
    "layout": "horizontal",
    "left_line": {
      "height": 1,
      "width_percent": 42
    },
    "text": {
      "value": "или",
      "width_percent": 16,
      "alignment": "center",
      "font": {
        "family": "SF Pro Text или Plus Jakarta Sans",
        "size": 24,
        "weight": 500,
        "line_height": 30
      }
    },
    "right_line": {
      "height": 1,
      "width_percent": 42
    }
  },
  "social_login": {
    "google_button": {
      "text": "Продолжить с Google",
      "position": {
        "top_margin_after_divider": 30
      },
      "height": 78,
      "width_percent": 100,
      "corner_radius": 24,
      "border_width": 1,
      "icon": {
        "type": "google_logo",
        "size": 34,
        "position": "left_inside_center",
        "x_offset": 250
      },
      "font": {
        "family": "SF Pro Text или Plus Jakarta Sans",
        "size": 28,
        "weight": 600,
        "line_height": 36
      },
      "logic": "Запускает Google Sign-In."
    }
  },
  "bottom_auth_link": {
    "login_state": {
      "text_prefix": "Нет аккаунта?",
      "text_action": "Зарегистрироваться",
      "action": "switch_to_register_tab"
    },
    "register_state": {
      "text_prefix": "Уже есть аккаунт?",
      "text_action": "Войти",
      "action": "switch_to_login_tab"
    },
    "position": {
      "top_margin": 42,
      "align": "center"
    },
    "font": {
      "family": "SF Pro Text или Plus Jakarta Sans",
      "size": 26,
      "weight_prefix": 400,
      "weight_action": 600,
      "line_height": 34
    },
    "tap_area": {
      "height": 52
    }
  },
  "form_register": {
    "visible_when": "auth_tabs.active == register",
    "recommended_variant": "simple_register",
    "fields": [
      {
        "id": "name",
        "type": "text",
        "placeholder": "Ваше имя",
        "icon": "user",
        "height": 78,
        "corner_radius": 24,
        "border_width": 1,
        "padding_left": 76,
        "padding_right": 28,
        "font": {
          "family": "SF Pro Text или Plus Jakarta Sans",
          "size": 28,
          "weight": 400,
          "line_height": 36
        },
        "icon_size": 32
      },
      {
        "id": "email",
        "type": "email",
        "placeholder": "Электронная почта",
        "icon": "mail",
        "height": 78,
        "corner_radius": 24,
        "border_width": 1,
        "padding_left": 76,
        "padding_right": 28,
        "top_margin": 24,
        "font": {
          "family": "SF Pro Text или Plus Jakarta Sans",
          "size": 28,
          "weight": 400,
          "line_height": 36
        },
        "icon_size": 32
      },
      {
        "id": "password",
        "type": "password",
        "placeholder": "Пароль",
        "icon_left": "lock",
        "icon_right": "eye",
        "height": 78,
        "corner_radius": 24,
        "border_width": 1,
        "padding_left": 76,
        "padding_right": 76,
        "top_margin": 24,
        "font": {
          "family": "SF Pro Text или Plus Jakarta Sans",
          "size": 28,
          "weight": 400,
          "line_height": 36
        },
        "icon_size": 32
      }
    ],
    "primary_button": {
      "text": "Зарегистрироваться",
      "position": {
        "top_margin": 38
      },
      "height": 86,
      "width_percent": 100,
      "corner_radius": 26,
      "font": {
        "family": "Plus Jakarta Sans или SF Pro Text",
        "size": 31,
        "weight": 700,
        "line_height": 40
      },
      "logic": {
        "default": "Активна, если имя заполнено, email валидный, пароль соответствует требованиям.",
        "loading_state": "Показывает loader.",
        "success": "Переход к onboarding или созданию первого семейного профиля."
      }
    },
    "terms_text": {
      "enabled": true,
      "text": "Продолжая, вы принимаете условия использования и политику конфиденциальности.",
      "position": {
        "top_margin": 24,
        "align": "center"
      },
      "font": {
        "family": "SF Pro Text или Plus Jakarta Sans",
        "size": 20,
        "weight": 400,
        "line_height": 28
      },
      "max_lines": 2,
      "logic": {
        "terms_link": "Открывает Terms of Use.",
        "privacy_link": "Открывает Privacy Policy."
      }
    }
  },
  "spacing_system": {
    "base_unit": 8,
    "vertical_rhythm": {
      "small": 16,
      "medium": 24,
      "large": 40,
      "section": 54
    },
    "horizontal_padding": 72,
    "field_gap": 24,
    "button_gap": 30
  },
  "typography_scale": {
    "app_name": {
      "size": 72,
      "weight": 700,
      "line_height": 82
    },
    "tab": {
      "size": 30,
      "weight": 600,
      "line_height": 38
    },
    "input": {
      "size": 28,
      "weight": 400,
      "line_height": 36
    },
    "button": {
      "size": 32,
      "weight": 700,
      "line_height": 40
    },
    "secondary_link": {
      "size": 25,
      "weight": 500,
      "line_height": 32
    },
    "bottom_link": {
      "size": 26,
      "weight": 400,
      "line_height": 34
    },
    "legal_text": {
      "size": 20,
      "weight": 400,
      "line_height": 28
    }
  },
  "interaction_logic": {
    "initial_state": "login",
    "keyboard_behavior": {
      "sheet_moves_up": true,
      "avoid_keyboard_overlap": true,
      "scroll_enabled_when_keyboard_open": true,
      "description": "При появлении клавиатуры форма должна немного подниматься или становиться scrollable, чтобы кнопка входа не скрывалась."
    },
    "validation": {
      "email": {
        "rule": "valid_email_format",
        "error_message": "Введите корректную электронную почту"
      },
      "password_login": {
        "rule": "not_empty",
        "error_message": "Введите пароль"
      },
      "password_register": {
        "rule": "minimum_8_characters",
        "error_message": "Пароль должен содержать минимум 8 символов"
      },
      "name": {
        "rule": "minimum_2_characters",
        "error_message": "Введите имя"
      }
    },
    "error_display": {
      "position": "below_field",
      "font_size": 20,
      "line_height": 26,
      "top_margin": 8
    },
    "loading": {
      "primary_button": "replace_text_with_spinner",
      "inputs": "remain_visible",
      "tabs": "disabled_during_request"
    }
  },
  "recommended_visual_hierarchy": [
    "1. Фоновая семейная сцена создает доверие и эмоцию.",
    "2. Нижний rounded sheet отделяет функциональную часть от картинки.",
    "3. Иконка и название PillPath дают узнаваемость.",
    "4. Segmented control сразу показывает два сценария: вход и регистрация.",
    "5. Поля максимально крупные, чтобы было удобно на iPhone.",
    "6. Основная кнопка — самый заметный элемент формы.",
    "7. Google login и нижняя ссылка остаются вторичными."
  ],
  "do_not": [
    "Не размещать форму поверх лиц семьи.",
    "Не делать фоновую картинку слишком контрастной.",
    "Не делать нижний sheet полностью прозрачным, иначе поля потеряются.",
    "Не использовать слишком мелкий текст ниже 20 px на canvas 1290x2796.",
    "Не делать кнопку регистрации и входа одинаково активными одновременно.",
    "Не перегружать экран длинным описанием приложения."
  ]
}