    "scale": "3x",
    "logical_size_pt": {
      "width": 430,
      "height": 932
    },
    "version": "1.0",
    "purpose": "Экран истории измерений роста ребёнка с мягкой сводкой за период, визуализацией динамики и хронологической историей измерений.",
    "concept": "Новый дизайн в стиле PillPath: крупный заголовок, сегменты периода, hero-summary карточка с мини-графиком, ключевые метрики и timeline-история измерений. Для роста используется мягкий лавандово-синий акцент, иконка ребёнка с ростомером и лёгкий график динамики."
  },
  "design_principles": {
    "visual_direction": [
      "warm",
      "soft",
      "premium",
      "clean",
      "editorial",
      "family-friendly",
      "calm",
      "growth-tracking"
    ],
    "avoid": [
      "старый фиолетовый экран целиком",
      "холодный клинический UI",
      "жёсткий SaaS-dashboard",
      "перегруженные таблицы",
      "слишком много маленьких KPI-плиток",
      "кислотный фиолетовый",
      "сильные тени",
      "агрессивные контрасты",
      "тяжёлый data-viz стиль"
    ],
    "must_have": [
      "крупный спокойный заголовок",
      "сегментированный выбор периода",
      "hero-summary карточка",
      "мягкий график динамики роста",
      "иконка роста/ростомера в hero-card",
      "ключевые показатели в одном компактном блоке",
      "primary CTA для добавления измерения",
      "timeline-история измерений"
    ]
  },
