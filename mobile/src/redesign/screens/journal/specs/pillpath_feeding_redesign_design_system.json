          "timeline_time",
          "timeline_day"
        ]
      },
      "main_card_right": {
        "contains": [
          "icon_badge",
          "entry_title",
          "entry_meta",
          "chevron_right"
        ],
        "layout": {
          "icon_badge_x": 34,
          "title_x": 132,
          "meta_x": 132,
          "chevron_align": "right_center"
        }
      }
