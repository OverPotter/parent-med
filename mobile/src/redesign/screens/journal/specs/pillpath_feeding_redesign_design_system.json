  "ai_assembly_rules": {
    "hierarchy": [
      "Сначала показать контекст экрана (назад + title + subtitle).",
      "Потом дать быстрое переключение периода.",
      "Потом показать summary-card со сводкой за период.",
      "Потом показать историю в хронологической timeline-ленте."
    ],
    "text_rules": [
      "Текст должен быть на русском.",
      "Заголовки — крупные и уверенные.",
      "Подписи и метаинформация — мягкие и вторичные.",
      "Никаких перегруженных описаний."
    ],
    "icon_rules": [
      "Иконки нужны только там, где они помогают сканированию.",
      "Не ставить лишние иконки в header subtitle и section title.",
      "В timeline использовать цветные badge-иконки как маркеры типа записи."
    ],
    "spacing_rules": [
      "Удерживать большие внешние поля.",
      "Не прижимать карточки друг к другу.",
      "Summary-card должна дышать.",
      "Timeline элементы должны иметь повторяемый ритм."
    ],
    "style_rules": [
      "Всё должно быть мягким, светлым, тёплым.",
      "Тени почти незаметные.",
      "Обводки тонкие, персиковые.",
      "Без холодной серой UI-эстетики."
    ]
  }
