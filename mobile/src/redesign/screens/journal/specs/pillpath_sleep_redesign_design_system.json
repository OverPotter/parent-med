    "scale": "3x",
    "logical_size_pt": {
      "width": 430,
      "height": 932
    },
    "version": "1.0",
    "purpose": "Экран истории сна ребёнка с мягкой сводкой за период и хронологической историей сессий сна.",
    "concept": "Сохраняем новую концепцию: крупный заголовок, сегменты периода, hero-summary карточка и timeline истории. Визуальный стиль тёплый, спокойный, семейный. Вместо персонажа в hero-блоке используется простая иконка сна и тематический фон: луна, звёзды, облака."
  },
  "design_principles": {
    "visual_direction": [
      "warm",
      "soft",
      "editorial",
      "calm",
      "family-friendly",
      "premium",
      "minimal-but-friendly"
    ],
    "avoid": [
      "холодный клинический интерфейс",
      "тяжёлый dashboard",
      "крупная иллюстрация спящего ребёнка",
      "перегруженность иконками",
      "кислотные фиолетовые заливки",
      "слишком мультяшный стиль",
      "агрессивные контрасты"
    ],
    "must_have": [
      "большой спокойный заголовок",
      "сегментированный выбор периода",
      "hero-summary карточка",
      "простая иконка сна как основной символ",
      "тематический фон с луной и звёздами",
      "timeline-история сессий сна",
      "мягкие светлые карточки с персиковой обводкой"
    ]
  },
