  "ai_assembly_rules": {
    "hierarchy": [
      "Сначала показать контекст экрана: back-link + title + subtitle.",
      "Потом дать сегментированный выбор периода.",
      "Потом показать hero-summary карточку со сводкой сна.",
      "Потом показать историю сна в timeline-формате."
    ],
    "content_rules": [
      "Русский язык интерфейса.",
      "Заголовки крупные и спокойные.",
      "Hero-блок должен читаться как мягкая сводка, а не как аналитический dashboard.",
      "Иконка сна — основная смысловая иконка hero-блока.",
      "Луна и звёзды — только фон, не отдельные крупные KPI-блоки."
    ],
    "icon_rules": [
      "Не перегружать экран иконками.",
      "Иконки в timeline использовать как маркеры типа записи.",
      "Hero-блок: один крупный бейдж сна слева и 3 маленьких иконки в метриках.",
      "Не использовать крупную персонажную иллюстрацию."
    ],
    "spacing_rules": [
