{
  "project": "PillPath",
  "screenId": "child_overview_graphics_v1",
  "screenName": "Обзор ребёнка — Графики",
  "platform": "iOS",
  "version": "1.0",
  "language": "ru",
  "description": "Спокойный, понятный и человечный экран графиков для обзора ребёнка. Экран помогает быстро понять картину за период через короткие KPI, bar chart, donut chart и пустые состояния.",
  "artboard": {
    "device": "iPhone 15 / 16 Pro Max",
    "sizePt": { "width": 430, "height": 932 },
    "exportPx": { "width": 1290, "height": 2796 },
    "safeAreaPt": { "top": 59, "bottom": 34, "left": 0, "right": 0 },
    "layout": {
      "horizontalPadding": 16,
      "contentWidth": 398,
      "verticalSpacing": [8, 12, 16, 20, 24, 32],
      "sectionGap": 18
    }
  },
  "designIntent": {
    "keywords": ["warm", "human", "intuitive", "soft", "readable", "care dashboard"],
    "principles": [
      "Графики должны быть простыми и моментально считываться.",
      "Сначала краткая сводка, затем визуализация, затем пустые состояния.",
      "Даже когда данных мало, экран не должен выглядеть пустым или сломанным.",
      "Подходит для родителей, бабушки, няни — без сложной аналитики и перегрузки."
    ]
  },
  "colorTokens": {
    "bg/base": "#FFF8F5",
    "bg/surface": "#FFFDFC",
    "bg/surfaceSoft": "#FDF4F0",
    "bg/activeSoft": "#FCE8E1",
    "border/subtle": "#F2DDD6",
    "border/soft": "#F7E9E3",
    "text/primary": "#15345B",
    "text/secondary": "#62728C",
    "text/muted": "#9AA5B5",
    "text/accent": "#FF7E6B",
    "icon/nav": "#6C829D",
    "brand/coral": "#FF7E6B",
    "brand/coralSoft": "#FFE6E0",
    "feeding/orange": "#F7A14C",
    "feeding/orangeSoft": "#FFF0DE",
    "illness/pink": "#F58E97",
    "illness/pinkSoft": "#FFE8EA",
    "sleep/purple": "#8B74D9",
    "sleep/purpleSoft": "#ECE6FF",
    "weight/teal": "#39C0A6",
    "weight/tealSoft": "#E4FAF5",
    "growth/green": "#8CCB2E",
    "growth/greenSoft": "#EEF9DD",
    "chart/grid": "#F4E6DF",
    "chart/donutBase": "#F3EFEC",
    "white": "#FFFFFF"
  },
  "typography": {
    "fontPrimary": "SF Pro Display",
    "fontSecondary": "SF Pro Text",
    "styles": {
      "navLink": { "fontFamily": "SF Pro Text", "weight": "Regular", "size": 16, "lineHeight": 20, "color": "{text/accent}" },
      "titleXL": { "fontFamily": "SF Pro Display", "weight": "Bold", "size": 34, "lineHeight": 40, "letterSpacing": -0.5, "color": "{text/primary}" },
      "bodyL": { "fontFamily": "SF Pro Text", "weight": "Regular", "size": 16, "lineHeight": 24, "color": "{text/secondary}" },
      "tabLabel": { "fontFamily": "SF Pro Text", "weight": "Semibold", "size": 17, "lineHeight": 22, "color": "{text/primary}" },
      "sectionTitle": { "fontFamily": "SF Pro Display", "weight": "Bold", "size": 26, "lineHeight": 32, "letterSpacing": -0.3, "color": "{text/primary}" },
      "cardTitle": { "fontFamily": "SF Pro Display", "weight": "Bold", "size": 18, "lineHeight": 24, "color": "{text/primary}" },
      "metricTitle": { "fontFamily": "SF Pro Text", "weight": "Semibold", "size": 16, "lineHeight": 20, "color": "{text/primary}" },
      "metricValue": { "fontFamily": "SF Pro Display", "weight": "Bold", "size": 17, "lineHeight": 22, "color": "{text/primary}" },
      "caption": { "fontFamily": "SF Pro Text", "weight": "Regular", "size": 15, "lineHeight": 20, "color": "{text/secondary}" },
      "chartLabel": { "fontFamily": "SF Pro Text", "weight": "Medium", "size": 14, "lineHeight": 18, "color": "{text/primary}" },
