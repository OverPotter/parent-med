      "emptyStateTitle": { "fontFamily": "SF Pro Text", "weight": "Semibold", "size": 17, "lineHeight": 22, "color": "{text/primary}" },
      "emptyStateBody": { "fontFamily": "SF Pro Text", "weight": "Regular", "size": 15, "lineHeight": 20, "color": "{text/secondary}" },
