    "border/soft": "#F7E9E3",
    "text/primary": "#15345B",
    "text/secondary": "#62728C",
    "text/muted": "#9AA5B5",
    "text/accent": "#FF7E6B",
    "icon/nav": "#6C829D",
    "brand/coral": "#FF7E6B",
    "brand/coralSoft": "#FFE6E0",
    "sleep/blue": "#4AA6F0",
    "feeding/orange": "#F7A14C",
    "illness/pink": "#F55F79",
    "weight/teal": "#39C0A6",
    "growth/green": "#8CCB2E",
    "purple/secondary": "#8B74D9",
    "white": "#FFFFFF",
