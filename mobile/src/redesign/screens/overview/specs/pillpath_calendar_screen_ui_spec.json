    "style": "rounded minimal outline or soft filled icons",
    "strokeWidth": 2,
    "baseSize": 22,
    "iconCircle": { "size": 48, "radius": 24 },
    "icons": {
      "sleep": { "symbol": "moon with stars", "fill": "{sleep/blue}", "circleBg": "#ECE6FF" },
