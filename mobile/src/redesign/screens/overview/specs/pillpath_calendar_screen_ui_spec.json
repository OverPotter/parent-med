{
  "project": "PillPath",
  "screenId": "child_overview_calendar_v2",
  "screenName": "Обзор ребёнка — Календарь",
  "version": "1.0",
  "platform": "iOS",
  "language": "ru",
  "description": "Человечный и интуитивный экран календаря для обзора активности ребёнка. Главная идея: пользователь сразу видит месяц, отмеченные дни и записи за выбранную дату.",
  "artboard": {
    "device": "iPhone 15 / 16 Pro Max",
    "sizePt": { "width": 430, "height": 932 },
    "exportPx": { "width": 1290, "height": 2796 },
    "safeAreaPt": { "top": 59, "bottom": 34, "left": 0, "right": 0 },
    "layout": {
      "horizontalPadding": 16,
      "contentWidth": 398,
      "gridColumns": 2,
      "columnGap": 10,
      "verticalSpacingScale": [8, 12, 16, 20, 24, 32]
    }
  },
  "designIntent": {
    "keywords": ["warm", "human", "care dashboard", "simple", "soft", "readable", "intuitive"],
    "principles": [
      "Один главный смысл на экране: выбрать день и увидеть записи.",
      "Календарь — главный фокус, а не второстепенный блок.",
      "Минимум лишних фильтров и пояснений.",
      "Сначала обзор месяца, затем детали выбранного дня.",
      "Цвета мягкие, но семантически различимые.",
      "Интерфейс должен быть понятен родителю, бабушке, няне."
    ]
  },
  "colorTokens": {
    "bg/base": "#FFF8F5",
