  "interactionRules": {
    "primaryAction": "Нажатие на день в календаре открывает записи за этот день ниже.",
    "calendarBehavior": [
      "Выбранный день подсвечивается мягким персиковым фоном.",
      "Если в дне есть события, под датой показываются цветные точки.",
      "Количество точек может быть от 0 до 3–4, в зависимости от типов событий.",
      "Серые числа верхней строки обозначают дни предыдущего месяца."
    ],
    "tabs": [
      "Лента — список событий по времени.",
      "Календарь — обзор активности по дням.",
      "Графики — агрегированные визуализации."
    ],
    "monthNavigation": [
      "Стрелки листают месяц.",
      "Период '7 дней' можно заменить на 14 дней, 30 дней, месяц."
    ],
    "selectedDayCard": [
      "Каждая строка ведёт в деталь записи.",
      "Кнопка 'Добавить запись' добавляет новую запись в выбранный день."
    ]
