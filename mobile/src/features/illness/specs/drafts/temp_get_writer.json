{
  "module_name": "ObservationQuickActions",
  "app": "PillPath",
  "language": "ru",
  "platform": "iOS",
  "screens": [
    "AddTemperatureScreen",
    "AddMedicineIntakeScreen",
    "AddObservationNoteScreen"
  ],
  "global_design_direction": {
    "goal": "Переосмыслить технические экраны старого журнала наблюдения болезни и привести их к новому мягкому, человеческому, семейному стилю PillPath.",
    "main_principle": "Каждый экран должен ощущаться как спокойный помощник родителя, а не как медицинская форма.",
    "style": [
      "тёплый кремовый фон",
      "мягкие карточки",
      "крупные читаемые поля",
      "человеческие подписи",
      "минимум технического языка",
      "дружелюбный детский аватар",
      "коралловый главный CTA",
      "мягкие подсказки без тревоги"
    ],
    "important_ux_rules": [
      "Пользователь должен быстро добавить запись за 10–20 секунд.",
      "Главная кнопка сохранения должна быть заметной.",
      "Все поля должны быть понятны без объяснений.",
      "Не заставлять пользователя заполнять лишнее.",
      "Последние записи показывать ниже формы.",
      "Если записей нет, показывать мягкий empty state.",
      "Не использовать фиолетовый старый фон.",
      "Не использовать жёсткие чёрные рамки.",
      "Не перегружать медицинскими терминами."
    ]
  },
  "target_device": {
    "design_width": 393,
    "design_height": 852,
    "export_width": 1290,
    "export_height": 2796,
    "safe_area": {
      "top": 54,
      "bottom": 34,
      "horizontal": 24
    }
  },
