  "screens_detail": {
    "AddTemperatureScreen": {
      "screen_name": "AddTemperatureScreen",
      "title": "Температура · Эдик",
      "subtitle": "Сохраните новый замер и сразу сверьтесь с последними значениями.",
      "purpose": "Быстро добавить новый замер температуры во время активного наблюдения болезни.",
      "main_change_from_old_design": "Убрать выбор вида измерения температуры. Больше не показывать 'подмышечная / ректально / ухо / лоб'. Оставить только значение, время и комментарий.",
      "layout": {
        "root": "shared.root_layout",
        "top_bar": "shared.top_bar",
        "hero": {
          "component": "shared.hero_header",
          "action_title": "Температура",
          "child_name": "Эдик",
          "subtitle": "Сохраните новый замер и сразу сверьтесь с последними значениями."
        },
        "form_card": {
          "component": "shared.form_card",
          "margin_top": 26,
          "children": [
            "temperature_value_block",
            "measured_at_field",
            "comment_field",
            "temperature_hint_box",
            "save_temperature_button"
          ]
        },
        "history_section": {
          "margin_top": 28,
          "children": [
            "section_header",
            "empty_state_or_recent_temperature_list",
            "encouragement_card"
          ]
        }
      },
      "components": {
        "temperature_value_block": {
          "label": "Новая температура",
          "field": {
            "height": 64,
            "layout": "horizontal",
            "background": "#FFFBF8",
            "border": {
              "width": 1,
              "color": "#EAD9D0"
            },
            "border_radius": 24,
            "padding": {
              "left": 14,
              "right": 14
            },
            "left_icon_container": {
              "size": 46,
              "border_radius": 999,
              "background": "#FFD6D8"
            },
            "left_icon": {
              "name": "Thermometer",
              "size": 24,
              "color": "#F56F68"
            },
            "input": {
              "type": "decimal",
              "value": "36.6",
              "placeholder": "36.6",
              "keyboard": "decimalPad",
              "font_style": "large_temperature_value",
              "text_align": "center",
              "allowed_range": {
                "min": 32.0,
                "max": 43.0
              }
            },
            "unit": {
              "text": "°C",
              "style": "unit"
            },
            "inline_action_button": {
              "text": "Добавить",
              "height": 50,
              "width": 116,
              "border_radius": 999,
              "background": "#F56F68",
              "text_color": "#FFFFFF",
              "font_style": "button",
              "note": "Можно использовать как быстрый save, но основной save всё равно остаётся внизу карточки. Если оставить две кнопки кажется лишним — убрать inline_action_button и оставить только большую кнопку 'Сохранить замер'."
            }
          }
        },
        "removed_measurement_type_selector": {
          "status": "removed",
          "old_options": [
            "Подмышечная",
            "Ректально",
            "Ухо",
            "Лоб"
          ],
          "reason": "Для быстрого родительского сценария это лишняя техническая детализация. Пользователь хочет быстро записать температуру, а не заполнять медицинскую анкету."
        },
        "measured_at_field": {
          "label": "Когда измерили?",
          "field": {
            "component": "shared.date_time_field",
            "value": "10 мая 2026 г., 12:54",
            "tap_action": "open_datetime_picker"
          }
        },
        "comment_field": {
          "label": "Комментарий",
          "label_suffix": "(необязательно)",
          "field": {
            "component": "shared.textarea",
            "height": 100,
            "placeholder": "Как себя чувствует?",
            "max_length": 120,
            "counter": "0/120"
          }
        },
        "temperature_hint_box": {
          "component": "shared.hint_box",
          "text": {
            "title": null,
            "body": "Измеряйте в спокойной обстановке. Повторные замеры делайте с интервалом не менее 30 минут."
          }
        },
        "save_temperature_button": {
          "component": "shared.primary_button",
          "text": "Сохранить замер",
          "margin_top": 18
        },
        "history_section": {
          "section_header": {
            "title": "Последние замеры",
            "count_badge": "0 записей"
          },
          "empty_state": {
            "illustration": {
              "type": "soft_3d",
              "name": "cute_thermometer",
              "description": "Мягкий маленький термометр с добрым лицом, пастельный коралловый оттенок."
            },
            "text": "Пока нет ни одного замера температуры."
          },
          "encouragement_card": {
            "title": "Вы молодцы!",
            "body": "Даже один замер помогает лучше понять состояние ребёнка.",
            "icon": "ShieldCheck"
          },
          "recent_item_example": {
            "height": 70,
            "background": "#FFFCF8",
            "border": {
              "width": 1,
              "color": "#EED8CE"
            },
            "border_radius": 20,
            "left": {
              "time": "12:54",
              "icon": "Thermometer",
              "icon_bg": "#FFD6D8",
              "icon_color": "#F56F68"
            },
            "content": {
              "title": "36.6 °C",
              "subtitle": "Как себя чувствует: бодрый"
            },
            "right": {
              "icon": "ChevronRight"
            }
          }
        }
      },
      "interaction_logic": {
        "on_open": [
          "Подставить child_id и child_name.",
          "По умолчанию значение температуры = пусто или последнее введённое пользователем значение, если он начал ввод.",
          "Дата и время = текущий момент.",
          "Кнопка 'Сохранить замер' disabled, пока поле температуры пустое или значение вне диапазона."
        ],
        "temperature_input": {
          "keyboard": "decimalPad",
          "auto_format": [
            "Разрешить ввод с точкой или запятой.",
            "Преобразовать запятую в точку внутри модели.",
            "Показывать одну цифру после запятой."
          ],
          "validation": {
            "required": true,
            "min": 32.0,
            "max": 43.0,
            "error_message_low": "Проверьте значение температуры.",
            "error_message_high": "Проверьте значение температуры."
          }
        },
        "datetime_field": {
          "tap": "open_datetime_picker_bottom_sheet",
          "allowed_range": {
            "from": "observation_start_date",
            "to": "now"
          }
        },
        "comment": {
          "required": false,
          "max_length": 120
        },
        "save": {
          "tap": {
            "action": "create_temperature_record",
            "payload": {
              "child_id": "{child_id}",
              "observation_id": "{observation_id}",
              "type": "temperature",
              "temperature_celsius": "{temperature_value}",
              "measured_at": "{selected_datetime}",
              "comment": "{comment_value}"
            },
            "success": [
              "Добавить запись в ленту наблюдения.",
              "Обновить карточку ребёнка в Журнале.",
              "Показать toast: Замер сохранён.",
              "Очистить поле или вернуться в Журнал — зависит от сценария."
            ]
          }
        }
      }
    },
    "AddMedicineIntakeScreen": {
      "screen_name": "AddMedicineIntakeScreen",
      "title": "Приём · Эдик",
      "subtitle": "Быстро отметьте, что и сколько дали ребёнку.",
      "purpose": "Добавить запись о приёме лекарства, витамина или другого средства во время наблюдения.",
      "layout": {
        "root": "shared.root_layout",
