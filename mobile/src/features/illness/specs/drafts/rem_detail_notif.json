{
  "module_name": "ObservationReminders",
  "app": "PillPath",
  "language": "ru",
  "platform": "iOS",
  "design_version": "PillPath Warm Family Health UI / Reminders v2",
  "decision": {
    "selected_variant": "variant_2",
    "reason": [
      "Вариант спокойнее и взрослее.",
      "Нет лишнего большого ребёнка и декоративной перегрузки.",
      "Карточки читаются лучше.",
      "Типсы стали контекстными и полезными.",
      "Экран лучше подходит для мам, пап, бабушек и нянь."
    ],
    "polish_rules": [
      "Заменить 'Активные напоминания' на 'Схемы приёма'.",
      "В карточке лекарства заменить 'сегодня: 0' на 'отмечено: 0'.",
      "Кнопка 'Отметить приём' становится коралловой только если приём уже пора.",
      "Типсы делать маленькими контекстными пояснениями, а не большими мотивационными блоками.",
      "Получателей показывать коротко: 'Артём, Мама' или 'Артём, Мама +2'."
    ]
  },
  "global_style": {
    "mood": [
      "спокойный",
      "семейный",
      "тёплый",
      "понятный",
      "не технический",
      "не игрушечный",
      "не больничный"
    ],
    "visual_principles": [
      "тёплый кремово-персиковый фон",
      "мягкие бело-кремовые карточки",
      "тонкие персиковые обводки",
      "крупная тёмная типографика",
      "коралловый цвет только для главных действий",
      "пастельные иконки",
      "минимум декоративных иллюстраций",
      "без больших персонажей на этих экранах"
    ],
    "avoid": [
      "старый фиолетовый фон",
      "огромный ребёнок с игрушкой",
      "сердечки и декоративные пятна",
      "жёсткие чёрные рамки",
      "слишком яркие красные кнопки",
      "медицинский/технический язык",
      "перегруженные типсы с лампочками"
    ]
  },
  "target_device": {
    "design_width": 393,
    "design_height": 852,
    "export_width": 1290,
    "export_height": 2796,
    "safe_area": {
