  "layout": {
    "root": {
      "type": "scroll_view",
      "background": {
        "type": "linear_gradient",
        "from": "#FFF4EC",
        "to": "#FFFDF9",
        "direction": "top_to_bottom"
      },
      "padding": {
        "left": 24,
        "right": 24,
        "top": 72,
        "bottom": 122
      },
      "content_behavior": "Если активных наблюдений больше двух, экран скроллится. Нижнее меню фиксировано поверх контента."
    },
    "status_bar": {
      "height": 54,
      "behavior": "system"
    },
    "header_top": {
      "type": "horizontal",
      "height": 64,
      "align": "center",
      "justify": "space_between",
      "margin_bottom": 28,
      "left": {
        "component": "app_icon",
        "size": 48
      },
      "right": {
        "type": "horizontal",
        "gap": 12,
        "items": [
          {
            "component": "circle_icon_button",
            "icon": "message"
          },
          {
            "component": "circle_icon_button",
            "icon": "profile"
          }
        ]
      }
    },
    "title_block": {
      "margin_bottom": 24,
      "title": {
        "text": "Журнал",
        "style": "page_title"
      },
      "subtitle": {
        "text": "Текущие наблюдения и быстрые действия.",
        "style": "page_subtitle",
        "margin_top": 6
      }
    },
    "children_observation_list": {
      "type": "vertical_list",
      "gap": 16,
      "item_component": "active_observation_child_card"
    },
    "bottom_tabbar": {
      "position": "fixed_bottom",
      "left": 16,
      "right": 16,
      "bottom": 14,
      "height": 86
    }
  },
