        },
        "finish_button": {
          "width": 108,
          "height": 44,
          "border_radius": 999,
          "background": "transparent",
          "border": {
            "width": 1.5,
            "color": "#F56F68"
          },
          "text": {
            "style": "button_text",
            "color": "#1E2A3A"
          },
          "states": {
            "default": {
