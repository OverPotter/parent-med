      "min_height": 294,
      "padding": 18,
      "border_radius": 28,
      "background": "#FFFCF8",
      "border": {
        "width": 1,
        "color": "#EED8CE"
      },
      "shadow": "card",
      "sections": [
        "child_header",
        "summary_chips",
        "quick_actions",
        "collapsed_feed_row"
      ],
      "child_header": {
        "type": "horizontal",
        "height": 92,
        "gap": 16,
        "avatar": {
          "size": 82,
          "border_radius": 22,
          "background": "#F8EDE6",
          "image_style": "friendly 3D child avatar, soft lighting, no photo realism, consistent with family app"
        },
        "content": {
          "type": "vertical",
          "flex": 1,
          "name_row": {
            "type": "horizontal",
            "align": "center",
