{
  "screen_name": "JournalActiveObservationList",
  "app": "PillPath",
  "language": "ru",
  "platform": "iOS",
  "target_device": {
    "name": "iPhone Pro Max",
    "design_width": 393,
    "design_height": 852,
    "pixel_export": {
      "width": 1290,
      "height": 2796
    },
    "safe_area": {
      "top": 54,
      "bottom": 34,
      "horizontal": 24
    }
  },
  "design_goal": {
    "main_task": "Переделать старый экран журнала наблюдения болезни в новый стиль PillPath.",
    "principle": "Экран должен показывать всех детей, у которых включено наблюдение, без раскрытой длинной ленты на главном экране.",
    "important": [
      "Лента не должна быть открыта по умолчанию.",
      "У каждого ребёнка должна быть своя компактная карточка наблюдения.",
      "Быстрые действия должны быть доступны прямо из карточки.",
      "Полная лента открывается отдельным экраном или через раскрытие внутри карточки.",
      "Если детей несколько, экран не должен ломаться и перегружаться."
    ]
  },
  "visual_style": {
    "mood": [
      "тёплый",
      "семейный",
      "мягкий",
      "современный",
      "заботливый",
      "не клинический",
      "не детская игрушка",
      "подходит мамам, папам, бабушкам и няням"
    ],
    "style_keywords": [
      "soft cream background",
      "warm pastel UI",
      "rounded cards",
      "thin warm outlines",
      "friendly child avatars",
      "soft shadows",
      "dark navy typography",
      "coral primary accent",
      "pastel medical categories"
    ],
    "avoid": [
      "старый фиолетовый фон",
      "жёсткие чёрные рамки",
      "слишком яркие неоновые цвета",
      "перегруженную открытую ленту",
      "мелкий нечитаемый текст",
      "обрезанные подписи кнопок",
      "слишком медицинский холодный стиль"
    ]
  },
