        "width": 1,
        "color": "#EED8CE"
      },
      "icon": {
        "size": 22,
        "stroke_width": 2,
        "color": "#1E2A3A"
      },
      "states": {
        "default": {
          "opacity": 1,
          "scale": 1
        },
        "pressed": {
          "opacity": 0.78,
          "scale": 0.96
        }
      }
    },
    "active_observation_child_card": {
      "type": "card",
