  "content_rules": {
    "page_title": "Журнал",
    "page_subtitle": "Текущие наблюдения и быстрые действия.",
    "status_badge": {
      "singular_day": "Болеет 1 день",
      "few_days": "Болеет {n} дня",
      "many_days": "Болеет {n} дней"
    },
    "summary_chips": {
      "temperature": "Темп. {value}",
      "medicine_count_1": "1 приём",
      "medicine_count_2_4": "{n} приёма",
      "medicine_count_5_plus": "{n} приёмов",
      "reminder_count_1": "1 напоминание",
      "reminder_count_2_4": "{n} напоминания",
      "reminder_count_5_plus": "{n} напоминаний"
    },
    "quick_actions": {
      "temperature": "+ Температура",
      "medicine": "+ Приём",
      "note": "+ Заметка",
      "reminder": "+ Напоминание"
    },
    "collapsed_feed": {
      "count_1": "Лента · 1 запись",
      "count_2_4": "Лента · {n} записи",
      "count_5_plus": "Лента · {n} записей",
      "empty": "Лента · пока нет записей"
    },
    "finish_button": "Завершить"
  },
  "interaction_logic": {
    "screen_entry": {
      "on_load": [
        "Получить список детей с active_observation = true.",
        "Отсортировать активные наблюдения: сначала дети с высокой температурой, затем новые наблюдения, затем остальные.",
        "Если активных наблюдений нет, показать empty state."
      ]
    },
    "child_card": {
      "tap_card": {
        "action": "open_child_observation_overview",
        "target": "ChildObservationOverviewScreen",
        "params": [
          "child_id",
          "observation_id"
        ]
      },
      "tap_finish": {
        "action": "show_confirmation_bottom_sheet",
        "title": "Завершить наблюдение?",
