        "gap": 10,
        "margin_top": 14,
        "height": 78,
        "responsive_behavior": {
          "small_width": "Если экран меньше 390 pt, можно сделать 2 колонки по 2 ряда.",
          "default": "На iPhone Pro Max — 4 кнопки в один ряд, чтобы карточка была ниже и компактнее."
        }
      },
      "collapsed_feed_row": {
        "type": "button_row",
