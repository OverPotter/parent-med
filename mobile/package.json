{
  "name": "expo-ios",
  "description": "PillPath iPhone-only Expo client",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "PATH=\"$(ruby -rrubygems -e 'print Gem.user_dir')/bin:$PATH\" expo run:ios",
    "ios:tunnel": "expo start --ios --tunnel",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~54.0.33",
    "expo-clipboard": "^55.0.13",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "^55.0.14",
    "expo-modules-core": "^3.0.30",
    "expo-notifications": "~0.32.12",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
