# Прод: origin бэкенда с протоколом (https://…), без пути; /api/v1 добавится в client.ts.
# Только hostname без https:// даст баг: запросы на фронт вида /hostname/api/v1/…
# Пример: https://pillpath-production.up.railway.app
# Приватные *.railway.internal в браузере не работают — только публичный URL.
# Задавайте в Variables до сборки фронта. Локально не задавайте — прокси Vite → :8000
# VITE_API_URL=

# Публичный origin клиентского приложения для share-ссылок и invite flow.
# Особенно важен для native iOS/Android, где window.location.origin может быть capacitor://localhost.
# Пример: https://parent-med-production-frontend.up.railway.app
# VITE_APP_SITE_URL=

# Публичные юридические ссылки (рекомендуется для App Store review; можно оставить внутренние /legal/*).
# VITE_PRIVACY_POLICY_URL=https://example.com/privacy
# VITE_TERMS_OF_USE_URL=https://example.com/terms
# VITE_SUPPORT_URL=https://example.com/support
# Публичный email поддержки. Рекомендуется для App Store review, чтобы /legal/support
# содержал внешний контакт даже без входа в приложение.
# VITE_SUPPORT_EMAIL=support@example.com
# Внешний маркетинговый лендинг для кнопки "О приложении" на native auth-экране.
# VITE_MARKETING_SITE_URL=https://example.com
# Публичный App Store URL iPhone-приложения.
# Используется сайтом как fallback CTA для invite/auth/recovery/app-only handoff экранов.
# Можно передать либо полный URL, либо только App Store ID приложения.
# Пример URL: https://apps.apple.com/app/id6762408566
# VITE_APP_STORE_URL=https://apps.apple.com/app/id6762408566
# VITE_APP_STORE_ID=6762408566

# RevenueCat public iOS SDK key and subscription defaults.
# Ключ публичный, его можно вшивать во frontend/native build.
# Entitlement лучше держать единым с backend access model, сейчас по умолчанию "plus".
# Опционально можно указать конкретный package id из current offering, иначе приложение возьмёт первый доступный пакет.
# VITE_REVENUECAT_IOS_API_KEY=
# VITE_REVENUECAT_SYNC_BACKEND=false
# VITE_REVENUECAT_ENTITLEMENT_CODE=plus
# VITE_REVENUECAT_DEFAULT_PACKAGE_ID=

# --- HitKeep (опционально): полный URL скрипта с инстанса, например http://localhost:8080/hk.js
# Без VITE_HITKEEP_SCRIPT_URL аналитика в коде не отправляется (удобно для dev без HitKeep).
# VITE_HITKEEP_SCRIPT_URL=
# Хеширование идентификаторов перенесено на backend (ANALYTICS_HASH_SALT),
# поэтому VITE_HITKEEP_USER_HASH_SALT во frontend больше не используется.
#
# Сборка фронта в Docker: VITE_* подставляются в образ через build.args в docker-compose.yml.
# В запущенном контейнере nginx эти переменные по умолчанию не нужны (Vite вшивает их в JS при build),
# но в compose для frontend добавлен блок environment — чтобы `docker exec pillpath_frontend env`
# показывал те же значения, что из вашего .env при `docker compose up`.
