{
  "name": "pillpath-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mobile": "npm run build && npx cap sync ios",
    "build:mobile:dev": "npm run build:mobile:web:dev && npx cap sync ios",
    "build:mobile:stage": "npm run build:mobile:web:stage && npx cap sync ios",
    "build:mobile:prod": "npm run build:mobile:web:prod && npx cap sync ios",
    "build:mobile:prod:local": "npm run build:mobile:prod",
    "build:mobile:web:dev": "tsc -b && vite build --mode mobile-dev",
    "build:mobile:web:stage": "tsc -b && vite build --mode mobile-stage",
    "build:mobile:web:prod": "tsc -b && vite build --mode mobile-prod",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "preview": "vite preview",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,js,json,css,md}\"",
    "lint": "tsc --noEmit && npx prettier --check \"src/**/*.{ts,tsx,js,json,css,md}\""
  },
  "dependencies": {
    "@capacitor/push-notifications": "^8.0.0",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
