# Parent Med Backend — пример переменных окружения
# Скопируйте в .env и подставьте свои значения.

# БД (async PostgreSQL через asyncpg). Можно вставить URL от Railway как postgres://… — в коде он приводится к postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parent_med

# Приложение
APP_NAME='Parent Med API'
DEBUG=false
JWT_SECRET='dev-jwt-secret-change-me'
JWT_ISSUER='parent-med'
ACCESS_TOKEN_TTL_MINUTES=10080
REFRESH_TOKEN_TTL_DAYS=180
# JSON-массив или список через запятую (на Railway удобнее второе).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ACCESS_COOKIE_NAME='parent_med_access_token'
REFRESH_COOKIE_NAME='parent_med_refresh_token'
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE='lax'
APP_TIMEZONE='Europe/Minsk'
PUSH_POLL_INTERVAL_SECONDS=5

# Web Push
# Для локальной разработки можно оставить пустыми, тогда push scheduler будет выключен.
WEB_PUSH_PUBLIC_KEY=''
WEB_PUSH_PRIVATE_KEY=''
WEB_PUSH_SUBJECT='mailto:dev@example.com'
