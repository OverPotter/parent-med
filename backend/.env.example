# PillPath Backend — пример переменных окружения
# Скопируйте в .env и подставьте свои значения.

# БД (async PostgreSQL через asyncpg). Можно вставить URL от Railway как postgres://… — в коде он приводится к postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parent_med

# Приложение
APP_NAME='PillPath API'
DEBUG=false
# Логи (Loguru): TRACE|DEBUG|INFO|…; файлы в backend/logs/
LOG_LEVEL=INFO
JWT_SECRET='dev-jwt-secret-change-me'
JWT_ISSUER='pillpath'
ACCESS_TOKEN_TTL_MINUTES=10080
REFRESH_TOKEN_TTL_DAYS=180
# JSON-массив или список через запятую (на Railway удобнее второе).
CORS_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://pillpath.localhost:3000,http://pillpath.localhost:5173
ACCESS_COOKIE_NAME='pillpath_access_token'
REFRESH_COOKIE_NAME='pillpath_refresh_token'
# Keep true in production HTTPS environments. Override to false only for local HTTP dev.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE='lax'
APP_TIMEZONE='Europe/Minsk'
PUSH_POLL_INTERVAL_SECONDS=5

# Optional: after migrations, auto-run curated catalog seed if the script exists in the image.
RUN_CURATED_CATALOG_SEED=0

# Web Push
# Для локальной разработки можно оставить пустыми, тогда push scheduler будет выключен.
WEB_PUSH_PUBLIC_KEY=''
WEB_PUSH_PRIVATE_KEY=''
WEB_PUSH_SUBJECT='mailto:dev@example.com'

# Apple Push Notifications (native iOS app).
# TestFlight uses production APNs, so keep sandbox disabled for TestFlight builds.
APNS_KEY_ID=''
APNS_TEAM_ID=''
APNS_BUNDLE_ID='com.overpotter.pillpath'
APNS_AUTH_KEY=''
APNS_USE_SANDBOX=false

# Analytics hash salt (server-side only; do not expose in frontend env).
ANALYTICS_HASH_SALT='replace-with-long-random-string'
