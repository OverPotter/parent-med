# Parent Med Backend — пример переменных окружения
# Скопируйте в .env и подставьте свои значения.

# БД (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parent_med

# Приложение
APP_NAME='Parent Med API'
DEBUG=false
JWT_SECRET='dev-jwt-secret-change-me'
JWT_ISSUER='parent-med'
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
