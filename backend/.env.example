# Parent Med Backend — пример переменных окружения
# Скопируйте в .env и подставьте свои значения.

# БД (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parent_med

# Приложение
APP_NAME='Parent Med API'
DEBUG=false
JWT_SECRET='dev-jwt-secret-change-me'
JWT_ISSUER='parent-med'
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]'
ACCESS_COOKIE_NAME='parent_med_access_token'
REFRESH_COOKIE_NAME='parent_med_refresh_token'
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE='lax'
